{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Current C File",
            "type": "shell",
            "command": "mkdir -p \"${workspaceFolder}/bin\" && gcc \"${file}\" -o \"${workspaceFolder}/bin/${fileBasenameNoExtension}\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}